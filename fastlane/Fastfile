default_platform(:android)

platform :android do
  desc "Upload a signed AAB (and IL2CPP debug symbols if present) to Google Play Console"
  lane :deploy do |options|
    repo_root = File.expand_path("..", __dir__)
    resolve_path = lambda do |path|
      raw = path.to_s.strip
      next nil if raw.empty?

      File.exist?(raw) ? File.expand_path(raw) : File.expand_path(raw, repo_root)
    end

    track = options[:track] || UI.user_error!("Missing required option :track (e.g. internal, beta, production)")
    aab_path = resolve_path.call(options[:aab]) || UI.user_error!("Missing required option :aab")
    UI.user_error!("AAB file not found at: #{aab_path}") unless File.file?(aab_path)

    release_status = (options[:release_status] || ENV.fetch("PLAY_RELEASE_STATUS", "draft")).to_s.strip
    release_status = "draft" if release_status.empty?

    rollout = options[:rollout]&.to_s&.strip
    rollout = nil if rollout.nil? || rollout.empty?

    # Google Play API rules:
    # - Draft releases cannot have a rollout fraction.
    # - Staged rollouts (< 1.0) must use release_status "inProgress".
    if release_status == "draft"
      rollout = nil
    elsif rollout && rollout.to_f > 0.0 && rollout.to_f < 1.0
      release_status = "inProgress"
    else
      rollout = nil
    end

    symbols_path = resolve_path.call(options[:symbols])
    if symbols_path.nil?
      symbols_path = Dir.glob(File.join(File.dirname(aab_path), "*.symbols.zip")).first
    end

    mapping_paths = []
    if symbols_path && File.file?(symbols_path)
      UI.message("Including native debug symbols: #{symbols_path}")
      mapping_paths << symbols_path
    else
      UI.important("No *.symbols.zip found alongside #{aab_path}; uploading AAB without native symbols.")
    end

    upload_params = {
      track: track,
      aab: aab_path,
      release_status: release_status,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    }
    upload_params[:mapping_paths] = mapping_paths unless mapping_paths.empty?
    upload_params[:rollout] = rollout if rollout

    upload_to_play_store(**upload_params)
  end

  desc "Promote an existing release between Google Play Console tracks without rebuilding"
  lane :promote do |options|
    from_track = options[:from] || "internal"
    to_track = options[:to] || "production"
    release_status = (options[:release_status] || ENV.fetch("PLAY_RELEASE_STATUS", "completed")).to_s.strip
    release_status = "completed" if release_status.empty?

    rollout = options[:rollout]&.to_s&.strip
    rollout = nil if rollout.nil? || rollout.empty?

    if release_status == "draft"
      rollout = nil
    elsif rollout && rollout.to_f > 0.0 && rollout.to_f < 1.0
      release_status = "inProgress"
    else
      rollout = nil
    end

    promote_params = {
      track: from_track,
      track_promote_to: to_track,
      track_promote_release_status: release_status,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    }
    promote_params[:rollout] = rollout if rollout

    upload_to_play_store(**promote_params)
  end
end
